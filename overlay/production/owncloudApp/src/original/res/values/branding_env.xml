<?xml version="1.0" encoding="utf-8"?>
<!--
  Aity Drive branding overlay - production Environment (drive.aity.tech).
  Overrides src/main values via the `original` flavor source set; see
  overlay/common for the shared bundle. GPLv2, like the tree it overlays.
-->
<resources>

    <string name="app_name" formatted="false">Aity Drive</string>

    <!-- Install identity: unique per Environment so production and staging
         coexist on one device (paired with applicationId tech.aity.drive
         from owncloudApp/gradle.properties) -->
    <string name="account_type" formatted="false">tech.aity.drive</string>
    <string name="authority" formatted="false">tech.aity.drive</string>
    <string name="document_provider_authority" formatted="false">tech.aity.drive.documents</string>
    <string name="file_provider_authority" formatted="false">tech.aity.drive.files</string>
    <string name="search_suggest_authority" formatted="false">tech.aity.drive.search.users_and_groups</string>
    <string name="search_suggest_intent_action" formatted="false">tech.aity.drive.search.users_and_groups.action.SHARE_WITH</string>
    <string name="data_folder" formatted="false">aitydrive</string>

    <!-- Locked server -->
    <string name="server_url" formatted="false">https://drive.aity.tech</string>

    <!-- OAuth2/OIDC redirect: aitydrive://android.aity.tech -->
    <string name="oauth2_redirect_uri_scheme">aitydrive</string>
    <string name="oauth2_redirect_uri_host">android.aity.tech</string>

    <!-- Deep links: distinct from the OAuth redirect scheme on purpose
         (upstream keeps oc vs owncloud apart too; LoginActivity treats any
         cold-start VIEW intent with data as a deep link) -->
    <string name="deep_link_uri_schemes">aitydrive-link</string>

    <!-- Only used by disabled features, kept accurate anyway -->
    <string name="url_app_download" formatted="false">https://play.google.com/store/apps/details?id=tech.aity.drive</string>

    <string name="url_privacy_policy" formatted="false">https://app.aity.tech/privacy/policy</string>
    <string name="aity_delete_account_url" formatted="false">https://app.aity.tech/privacy/account-deletion</string>
    <string name="aity_delete_data_url" formatted="false">https://app.aity.tech/privacy/data-deletion</string>

</resources>
