<?xml version="1.0" encoding="utf-8"?>
<!-- Style overrides for the slate chrome. Each REPLACES the same-named
     upstream style wholesale, so every upstream item is copied here and
     must be re-checked on a Bump (both are 2 items and stable). GPLv2. -->
<resources>
    <!-- Upstream: statusBarColor transparent + null animation. Transparent
         lets an unidentified view paint @color/primary behind the status
         bar (seen 2026-09-07); opaque slate covers it. -->
    <style name="Theme.ownCloud.Toolbar.Drawer">
        <item name="android:statusBarColor">#1E293B</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
