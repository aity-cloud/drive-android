# Aity Drive for Android - deploy lanes. CI publishes, humans promote:
# these lanes are invoked by the publish-staging and promote jobs only
# (never from a workstation) once PLAY_SERVICE_ACCOUNT_JSON exists.
default_platform(:android)

platform :android do
  desc "Upload an AAB to a Play track (defaults: staging app, internal track)"
  desc "  fastlane android deploy aab:dist/staging/<file>.aab"
  desc "  options: package_name (tech.aity.drive.staging), track (internal),"
  desc "           release_status (draft until the listing is public)"
  lane :deploy do |options|
    aab = options[:aab] || UI.user_error!("pass aab:dist/<env>/<file>.aab")
    package = options[:package_name] || "tech.aity.drive.staging"
    track = options[:track] || "internal"

    # The staging app exists for internal testing and nothing else. It has no
    # public listing and must never reach a public track, whatever a caller
    # passes.
    if package.end_with?(".staging") && !%w[internal alpha].include?(track)
      UI.user_error!("refusing to put #{package} on the '#{track}' track: " \
                     "the staging app stays in closed testing (RELEASING.md)")
    end

    supply(
      package_name: package,
      track: track,
      aab: aab,
      # completed since 2026-09-07: both apps are published (closed testing),
      # so uploads go live to the track's testers without a Console click.
      # Production keeps passing release_status:draft explicitly - the final
      # rollout stays a human act in the Console.
      release_status: options[:release_status] || "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
    )
  end

  desc "Push the listing texts under fastlane/metadata/android to Play"
  lane :metadata do |options|
    supply(
      package_name: options[:package_name] || "tech.aity.drive",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end
end
